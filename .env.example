# 应用配置
APP_NAME="GPT Team 成员管理系统"
APP_VERSION="0.2.0"
APP_HOST="0.0.0.0"
APP_PORT=8008
OAUTH_REDIRECT_URI="http://localhost:1455/auth/callback"
DEBUG=True

# 数据库配置
# 默认数据库位于项目 data/team_manage.db；Docker Compose 会自动覆盖容器路径。

# 安全配置
SECRET_KEY="your-secret-key-here-change-in-production"
ADMIN_PASSWORD="admin123"  # 首次启动后请修改

# 日志配置
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
DATABASE_ECHO=False  # 是否打印 SQL 语句

# 代理配置 (可选)
PROXY=""  # 格式: http://host:port 或 socks5://host:port 或 socks5://user:pass@host:port
PROXY_ENABLED=False

# JWT 配置
JWT_VERIFY_SIGNATURE=False  # 开发环境可设为 False,生产环境建议设为 True

# 时区配置
TIMEZONE=Asia/Shanghai  # 默认使用中国时区
